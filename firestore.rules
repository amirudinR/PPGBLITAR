rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserData().role == role;
    }
    
    function hasOneOfRoles(roles) {
      return isAuthenticated() && currentUserData().role in roles;
    }

    function isAdmin() {
      return hasOneOfRoles(['adminsuper', 'admin']);
    }

    // === Aturan untuk Koleksi 'users' ===
    match /users/{userId} {
      // Baca: Semua pengguna terautentikasi bisa membaca data pengguna lain untuk keperluan dashboard, dll.
      allow read: if isAuthenticated();
      
      allow create: if true;
                       
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      
      allow delete: if hasRole('adminsuper') ||
                     (hasRole('admin') && resource.data.role != 'adminsuper') ||
                     (hasRole('desa') && resource.data.role == 'guru' && resource.data.desa == currentUserData().desa) ||
                     (hasRole('kelompok') && resource.data.role == 'guru' && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
    }

    // === Aturan untuk Data Master ('desa', 'kelompok') ===
    match /desa/{desaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /kelompok/{kelompokId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('desa');
    }

    // === Aturan untuk Data Operasional ('generus', 'attendance', 'materials', 'gurus', 'kelas') ===
    match /generus/{generusId} {
      // Baca: Semua pengguna terautentikasi bisa membaca data generus untuk keperluan dashboard.
      allow read: if isAuthenticated();
                   
      // Tulis: Dibatasi berdasarkan peran dan lingkup.
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /gurus/{guruId} {
      // Baca: Semua pengguna terautentikasi bisa membaca data guru.
      allow read: if isAuthenticated();
                   
      // Tulis: Dibatasi berdasarkan peran dan lingkup.
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /kelas/{kelasId} {
      // Baca: Semua pengguna terautentikasi bisa membaca data kelas.
      allow read: if isAuthenticated();
                   
      // Tulis: Dibatasi berdasarkan peran dan lingkup.
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /attendance/{attendanceId} {
      // Baca: Semua pengguna terautentikasi bisa membaca data kehadiran.
      allow read: if isAuthenticated();

      // Tulis: Dibatasi berdasarkan peran dan lingkup.
      allow write: if isAdmin() || 
                         (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                         (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }
    
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('kelompok');
    }
  }
}