rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function - get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (adminsuper or admin)
    function isAdmin() {
      return isAuthenticated() && 
             (getUserData().role == 'adminsuper' || getUserData().role == 'admin');
    }
    
    // Check if user is PJP Desa
    function isPJPDesa() {
      return isAuthenticated() && getUserData().role == 'desa';
    }
    
    // Check if user is PJP Kelompok
    function isPJPKelompok() {
      return isAuthenticated() && getUserData().role == 'kelompok';
    }
    
    // Check if user is Guru
    function isGuru() {
      return isAuthenticated() && getUserData().role == 'guru';
    }
    
    // Check if user is Orang Tua
    function isOrangTua() {
      return isAuthenticated() && getUserData().role == 'orangtua';
    }
    
    // ============== USERS COLLECTION ==============
    match /users/{userId} {
      // Allow read for authenticated users - admins see all, others see only themselves
      allow read: if isAuthenticated() &&
                    (isAdmin() ||
                     request.auth.uid == userId ||
                     // PJP Desa can see users in their desa
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     // PJP Kelompok can see users in their kelompok
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));

      allow create: if isAdmin() ||
                    (isPJPDesa() &&
                     request.resource.data.role in ['kelompok', 'guru', 'orangtua'] &&
                     request.resource.data.desa == getUserData().desa) ||
                    (isPJPKelompok() &&
                     request.resource.data.role in ['guru', 'orangtua'] &&
                     request.resource.data.desa == getUserData().desa &&
                     request.resource.data.kelompok == getUserData().kelompok);

      allow update: if isAdmin() ||
                    (request.auth.uid == userId &&
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.status == resource.data.status &&
                     request.resource.data.desa == resource.data.desa &&
                     request.resource.data.kelompok == resource.data.kelompok &&
                     request.resource.data.email == resource.data.email);

      allow delete: if isAdmin();
    }
    
    // ============== DESA COLLECTION ==============
    match /desa/{desaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============== KELOMPOK COLLECTION ==============
    match /kelompok/{kelompokId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isPJPDesa();
    }
    
    // ============== GURUS COLLECTION ==============
    match /gurus/{guruId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == resource.data.userId));
      
      allow create: if isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok);
      
      allow update: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
      
      allow delete: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa);
    }
    
    // ============== KELAS COLLECTION ==============
    match /kelas/{kelasId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow create: if isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok);
      
      allow update: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
      
      allow delete: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa);
    }
    
    // ============== GENERUS COLLECTION ==============
    match /generus/{generusId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow create: if isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok);
      
      allow update: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
      
      allow delete: if isAdmin() || 
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
    }
    
    // ============== MATERIALS COLLECTION ==============
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isPJPDesa();
    }
    
    // ============== MONTHLY ATTENDANCE COLLECTION ==============
    match /monthlyAttendance/{attendanceId} {
      allow read: if isAuthenticated() &&
                    (isAdmin() ||
                     isPJPDesa() ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == resource.data.guruId));

      allow create: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == request.resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == request.resource.data.guruId));

      allow update: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isGuru() && request.auth.uid == resource.data.guruId && request.auth.uid == request.resource.data.guruId) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));

      allow delete: if isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isGuru() && request.auth.uid == resource.data.guruId);
    }
    
    // ============== GRADES COLLECTION ==============
    match /grades/{gradeId} {
      allow read: if isAuthenticated() &&
                    (isAdmin() ||
                     isPJPDesa() ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == resource.data.guruId));

      allow create: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == request.resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == request.resource.data.guruId));

      allow update: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isGuru() && request.auth.uid == resource.data.guruId && request.auth.uid == request.resource.data.guruId) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));

      allow delete: if isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isGuru() && request.auth.uid == resource.data.guruId);
    }
    
    // ============== M5U COLLECTION ==============
    match /m5u/{m5uId} {
      allow read: if isAuthenticated() &&
                    (isAdmin() ||
                     isPJPDesa() ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isOrangTua() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));

      allow create: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == request.resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == request.resource.data.guruId));

      allow update: if isAuthenticated() &&
                     (isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && request.auth.uid == resource.data.guruId));

      allow delete: if isAdmin() ||
                     (isPJPDesa() && getUserData().desa == resource.data.desa) ||
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
    }
    
    // ============== ANNOUNCEMENTS COLLECTION ==============
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     getUserData().role in resource.data.targetRoles);
      
      allow write: if isAdmin();
    }
    
    // ============== LATIHAN ASAD COLLECTION ==============
    match /latihanASAD/{latihanId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow create: if isAuthenticated() &&
                     (isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok));
      
      allow update: if isAuthenticated() &&
                     (isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow delete: if isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
    }
    
    // ============== JARIYAH PPG COLLECTION ==============
    match /jariyahPPG/{jariyahId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok) ||
                     (isGuru() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow create: if isAuthenticated() &&
                     (isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == request.resource.data.desa && getUserData().kelompok == request.resource.data.kelompok));
      
      allow update: if isAuthenticated() &&
                     (isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok));
      
      allow delete: if isAdmin() || isPJPDesa() || 
                     (isPJPKelompok() && getUserData().desa == resource.data.desa && getUserData().kelompok == resource.data.kelompok);
    }
    
    // ============== FEATURE PERMISSIONS COLLECTION ==============
    match /featurePermissions/{permissionId} {
      // All authenticated users can read (to check their access)
      allow read: if isAuthenticated();
      
      // Only adminsuper can write
      allow write: if isAuthenticated() && getUserData().role == 'adminsuper';
    }
  }
}