rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserData().role == role;
    }
    
    function hasOneOfRoles(roles) {
      return isAuthenticated() && currentUserData().role in roles;
    }

    function isAdmin() {
      return hasOneOfRoles(['adminsuper', 'admin']);
    }

    // === Aturan untuk Koleksi 'users' ===
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Membatasi pembuatan dokumen hanya untuk pengguna yang sudah terotentikasi
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if hasRole('adminsuper') ||
                     (hasRole('admin') && resource.data.role != 'adminsuper') ||
                     (hasRole('desa') && resource.data.role == 'guru' && resource.data.desa == currentUserData().desa) ||
                     (hasRole('kelompok') && resource.data.role == 'guru' && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
    }

    // === Aturan untuk Data Master ('desa', 'kelompok') ===
    match /desa/{desaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /kelompok/{kelompokId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('desa');
    }

    // === Aturan untuk Data Operasional ===
    match /generus/{generusId} {
      // Pengguna hanya bisa membaca data generus dalam lingkup mereka (desa/kelompok)
      allow read: if isAdmin() ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok) ||
                   (hasRole('guru') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
      
      // Update aturan untuk write (create dan update)
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
      
      // Tambahkan aturan khusus untuk delete
      allow delete: if isAdmin() ||
                     (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                     (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
    }

    match /gurus/{guruId} {
      // Pengguna hanya bisa membaca data guru dalam lingkup mereka
      allow read: if isAdmin() ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok) ||
                   (hasRole('guru') && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /kelas/{kelasId} {
      // Pengguna hanya bisa membaca data kelas dalam lingkup mereka
      allow read: if isAdmin() ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok) ||
                   (hasRole('guru') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }
    
    match /monthlyAttendance/{attendanceId} {
      // Admin, PJP Desa, dan PJP Kelompok dapat membaca data kehadiran dalam lingkup mereka.
      // Guru hanya dapat membaca data kehadiran yang mereka buat.
      allow read: if isAdmin() ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok) ||
                   (hasRole('guru') && resource.data.guruId == request.auth.uid);
      // Hanya guru yang bisa menulis data kehadiran, dan harus sesuai dengan ID mereka. Admin juga bisa menulis.
      allow write: if isAdmin() || (hasRole('guru') && request.resource.data.guruId == request.auth.uid);
    }
    
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('kelompok');
    }

    match /grades/{gradeId} {
      // Admin, PJP Desa, dan PJP Kelompok dapat membaca data nilai dalam lingkup mereka.
      // Guru hanya dapat membaca data nilai yang mereka buat.
      allow read: if isAdmin() ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok) ||
                   (hasRole('guru') && resource.data.guruId == request.auth.uid);
      // Hanya guru yang bertanggung jawab yang dapat membuat/memperbarui nilai.
      allow write: if hasRole('guru') && request.resource.data.guruId == request.auth.uid;
    }

    // === Aturan untuk M5U ===
    match /m5u/{m5uId} {
      // Admin bisa membaca semua data M5U
      allow read: if isAdmin();
      
      // PJP Desa bisa membaca data M5U di desanya
      allow read: if hasRole('desa') && resource.data.desa == currentUserData().desa;
      
      // PJP Kelompok bisa membaca data M5U di kelompoknya
      allow read: if hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok;
      
      // Guru bisa membaca data M5U yang mereka buat
      allow read: if hasRole('guru') && resource.data.guruId == request.auth.uid;
      
      // Orang tua bisa membaca data M5U di kelompoknya
      allow read: if hasRole('orangtua') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok;
      
      // Write permissions
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok) ||
                    (hasRole('guru') && request.resource.data.guruId == request.auth.uid);
    }

    match /announcements/{announcementId} {
      // Admin bisa membaca semua, pengguna lain hanya bisa membaca jika peran mereka ada di targetRoles.
      allow read: if isAdmin() || (isAuthenticated() && currentUserData().role in resource.data.targetRoles);
      // Hanya admin yang bisa membuat, mengubah, atau menghapus pengumuman.
      allow write: if isAdmin();
    }
  }
}