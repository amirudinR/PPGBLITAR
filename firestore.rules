rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && currentUserData().role == role;
    }
    
    function hasOneOfRoles(roles) {
      return isAuthenticated() && currentUserData().role in roles;
    }

    function isAdmin() {
      return hasOneOfRoles(['adminsuper', 'admin']);
    }

    // === Aturan untuk Koleksi 'users' ===
    match /users/{userId} {
      // Baca: Admin bisa baca semua. Pengguna bisa baca data sendiri.
      // PJP Desa/Kelompok bisa baca pengguna dalam lingkup mereka.
      allow read: if isAdmin() || 
                   (isAuthenticated() && request.auth.uid == userId) ||
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
      
      allow create: if true;
                       
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      
      allow delete: if hasRole('adminsuper');
    }

    // === Aturan untuk Data Master ('desa', 'kelompok') ===
    match /desa/{desaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /kelompok/{kelompokId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('desa');
    }

    // === Aturan untuk Data Operasional ('generus', 'attendance', 'materials', 'gurus') ===
    match /generus/{generusId} {
      // Baca: Admin bisa baca semua. PJP Desa/Kelompok bisa baca generus dalam lingkup mereka.
      allow read: if isAdmin() || 
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
                   
      // Tulis: Admin bisa tulis semua. PJP Desa/Kelompok bisa tulis generus dalam lingkup mereka.
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /gurus/{guruId} {
      // Baca: Admin bisa baca semua. PJP Desa/Kelompok bisa baca guru dalam lingkup mereka.
      allow read: if isAdmin() || 
                   (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                   (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
                   
      // Tulis: Admin bisa tulis semua. PJP Desa/Kelompok bisa tulis guru dalam lingkup mereka.
      allow write: if isAdmin() || 
                    (hasRole('desa') && request.resource.data.desa == currentUserData().desa) ||
                    (hasRole('kelompok') && request.resource.data.desa == currentUserData().desa && request.resource.data.kelompok == currentUserData().kelompok);
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAdmin() || 
                         (hasRole('desa') && resource.data.desa == currentUserData().desa) ||
                         (hasRole('kelompok') && resource.data.desa == currentUserData().desa && resource.data.kelompok == currentUserData().kelompok);
    }
    
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('kelompok');
    }
  }
}