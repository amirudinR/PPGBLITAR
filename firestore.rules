rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data from 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS collection
    // Allow users to read their own data.
    // Allow admins to read/write any user data.
    // Allow users to update their own data.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // For registration
      allow update: if request.auth.uid == userId || getUserData().role in ['adminsuper', 'admin'];
      allow delete: if getUserData().role in ['adminsuper', 'admin'];
    }

    // DESA, KELOMPOK, MATERIALS collections
    // Allow any authenticated user to read.
    // Only admins can write.
    match /(desa|kelompok|materials)/{docId} {
      allow read: if isAuthenticated();
      allow write: if getUserData().role in ['adminsuper', 'admin', 'desa'];
    }

    // GURUS collection
    // Allow authenticated users to read.
    // Allow admins/desa admins to manage gurus.
    match /gurus/{guruId} {
      allow read: if isAuthenticated();
      allow write: if getUserData().role in ['adminsuper', 'admin', 'desa', 'kelompok'];
    }

    // KELAS collection
    // Allow read based on role.
    // Allow write for admins/desa/kelompok.
    match /kelas/{classId} {
      allow read: if isAuthenticated();
      allow write: if getUserData().role in ['adminsuper', 'admin', 'desa', 'kelompok'];
    }

    // GENERUS collection
    // Allow read/write based on user's scope (desa/kelompok).
    // Gurus can read students in their scope.
    match /generus/{generusId} {
      allow read: if isAuthenticated() && (
        getUserData().role in ['adminsuper', 'admin'] ||
        (getUserData().role == 'desa' && getUserData().desa == resource.data.desa) ||
        (getUserData().role == 'kelompok' && getUserData().kelompok == resource.data.kelompok && getUserData().desa == resource.data.desa) ||
        (getUserData().role == 'guru' && getUserData().kelompok == resource.data.kelompok && getUserData().desa == resource.data.desa)
      );
      allow write: if isAuthenticated() && (
        getUserData().role in ['adminsuper', 'admin'] ||
        (getUserData().role == 'desa' && getUserData().desa == resource.data.desa) ||
        (getUserData().role == 'kelompok' && getUserData().kelompok == resource.data.kelompok && getUserData().desa == resource.data.desa)
      );
    }

    // MONTHLY ATTENDANCE collection
    // Admins/desa/kelompok can read/write within their scope.
    // Gurus can only read/write attendance records where their UID matches the guruId.
    match /monthlyAttendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        getUserData().role in ['adminsuper', 'admin'] ||
        (getUserData().role == 'desa' && getUserData().desa == resource.data.desa) ||
        (getUserData().role == 'kelompok' && getUserData().kelompok == resource.data.kelompok && getUserData().desa == resource.data.desa) ||
        (getUserData().role == 'guru' && request.auth.uid == resource.data.guruId)
      );
      allow write: if isAuthenticated() && (
        getUserData().role in ['adminsuper', 'admin'] ||
        (getUserData().role == 'guru' && request.auth.uid == request.resource.data.guruId)
      );
    }
  }
}